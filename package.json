{
  "name": "zimny",
  "private": true,
  "type": "module",
  "description": "Zimny — a stylized 3D recreation of the Winter Palace (Hermitage, Saint Petersburg) in the browser.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "budget": "node tools/budget.mjs",
    "fonts": "node tools/fonts/subset.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm budget",
    "asset:bpy": "node tools/asset.mjs bpy",
    "asset:gltf": "node tools/asset.mjs gltf",
    "asset:bake": "node tools/asset.mjs bake",
    "asset:manifest": "node tools/asset.mjs manifest",
    "asset:basis": "node tools/asset.mjs basis",
    "asset:gallery-layout": "node tools/gallery/layout.mjs",
    "asset:gallery-atlas": "node tools/gallery/atlas.mjs",
    "asset": "node tools/asset.mjs all"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@gltf-transform/cli": "4.5.1",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-serif": "2.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "fontkit": "^2.0.4",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
